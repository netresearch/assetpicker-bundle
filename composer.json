{
    "name": "netresearch/assetpicker-bundle",
    "description": "Symfony bundle for AssetPicker: the proxy route for CORS-restricted storages and a Twig function that renders the picker configuration",
    "type": "symfony-bundle",
    "keywords": ["symfony", "bundle", "asset-picker", "file-picker", "proxy"],
    "license": "MIT",
    "authors": [
        {
            "name": "Christian Opitz",
            "email": "christian.opitz@netresearch.de"
        }
    ],
    "require": {
        "php": "^8.4",
        "netresearch/assetpicker": "^2.0",
        "symfony/config": "^8.0.13",
        "symfony/dependency-injection": "^8.0.13",
        "symfony/framework-bundle": "^8.0.13",
        "symfony/http-client": "^8.0.13",
        "symfony/http-foundation": "^8.0.13",
        "symfony/http-kernel": "^8.0.13",
        "symfony/routing": "^8.0.13",
        "twig/twig": "^3.27"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.3",
        "symfony/browser-kit": "^8.0.13",
        "symfony/twig-bundle": "^8.0.13"
    },
    "suggest": {
        "symfony/twig-bundle": "Registers the assetpicker_config() Twig function in your application"
    },
    "autoload": {
        "psr-4": {
            "Netresearch\\AssetPickerBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Netresearch\\AssetPickerBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --no-progress"
    }
}
